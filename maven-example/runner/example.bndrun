-standalone: true
-runfw: org.apache.felix.framework
-runee: JavaSE-17
-runstartlevel: order=leastdependenciesfirst, begin=10, step=10
-runrequires: \
	osgi.identity;filter:='(osgi.identity=app-bundle)',\
	osgi.identity;filter:='(osgi.identity=com.sun.xml.bind.jaxb-impl)'
-runbundles: \
	jakarta.activation-api;version='[2.1.3,2.1.4)';startlevel=10,\
	com.sun.xml.bind.jaxb-core;version='[4.0.5,4.0.6)';startlevel=20,\
	com.sun.xml.bind.jaxb-impl;version='[4.0.5,4.0.6)';startlevel=30,\
	jakarta.xml.bind-api;version='[4.0.2,4.0.3)';startlevel=40,\
	org.glassfish.hk2.osgi-resource-locator;version='[3.0.0,3.0.1)';startlevel=50,\
	app-bundle;version='[1.0.0,1.0.1)';startlevel=60