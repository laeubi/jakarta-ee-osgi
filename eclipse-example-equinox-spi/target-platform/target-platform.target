<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="jakarta-ee-osgi" sequenceNumber="1">
	<locations>
		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="false" type="InstallableUnit">
			<unit id="org.eclipse.osgi" version="0.0.0"/>
			<unit id="org.eclipse.equinox.simpleconfigurator" version="0.0.0"/>
			<unit id="org.eclipse.equinox.launcher" version="0.0.0"/>
			<unit id="org.eclipse.equinox.spi" version="0.0.0"/>
			<repository location="https://download.eclipse.org/releases/milestone/"/>
		</location>
		<location includeDependencyDepth="infinite" includeDependencyScopes="compile" includeSource="false" missingManifest="error" type="Maven">
			<dependencies>
				<dependency>
					<groupId>jakarta.xml.bind</groupId>
					<artifactId>jakarta.xml.bind-api</artifactId>
					<version>4.0.2</version>
					<type>jar</type>
				</dependency>
				<dependency>
					<groupId>com.sun.xml.bind</groupId>
					<artifactId>jaxb-impl</artifactId>
					<version>4.0.5</version>
					<type>jar</type>
				</dependency>
				<dependency>
					<groupId>com.sun.xml.bind</groupId>
					<artifactId>jaxb-core</artifactId>
					<version>4.0.5</version>
					<type>jar</type>
				</dependency>
			</dependencies>
		</location>
	</locations>
</target>
